# Backend API used for normal application and GitHub authentication requests.
VITE_VEREN_API_BASE_URL=http://localhost:8001/api/v1

# Logs service used for build-log streaming and static log retrieval.
VITE_VEREN_LOGS_STREAM_BASE_URL=http://localhost:8007/api/v1

# Backend route used to refresh browser authentication tokens.
VITE_VEREN_AUTH_REFRESH_ENDPOINT=/auth/refresh-token
